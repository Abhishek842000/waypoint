# Postgres
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
DATABASE_URL=postgresql://waypoint:waypoint@localhost:5433/waypoint?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379
# 1 = real minutes. 0.0333 ≈ 10 seconds per 5 policy minutes (10/300).
ESCALATION_DELAY_MULTIPLIER=1

# API
API_PORT=3001
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Worker
WORKER_CONCURRENCY=5

# Notifications (Slack webhook is stored per-org in Settings)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
RESEND_FROM=Waypoint <noreply@localhost>

