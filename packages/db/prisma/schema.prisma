generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  responder
  viewer
}

enum ServiceStatus {
  operational
  degraded
  partial_outage
  major_outage
}

enum IncidentStatus {
  triggered
  acknowledged
  resolved
}

enum IncidentSeverity {
  critical
  high
  medium
  low
}

enum IncidentEventType {
  triggered
  acknowledged
  escalated
  comment
  resolved
}

enum EscalationTargetType {
  rotation
  user
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           Membership[]
  acknowledgedIncidents Incident[]       @relation("AcknowledgedBy")
  events                IncidentEvent[]
  rotationMemberships   RotationMember[]
}

model Org {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  services           Service[]
  rotations          Rotation[]
  escalationPolicies EscalationPolicy[]
  incidents          Incident[]
  apiKeys            ApiKey[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Service {
  id            String        @id @default(cuid())
  orgId         String
  name          String
  currentStatus ServiceStatus @default(operational)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  incidents Incident[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Rotation {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  currentPointer Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org     Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members RotationMember[]
  steps   EscalationStep[]

  @@unique([orgId, name])
  @@index([orgId])
}

model RotationMember {
  id         String @id @default(cuid())
  orgId      String
  rotationId String
  userId     String
  position   Int

  rotation Rotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rotationId, userId])
  @@unique([rotationId, position])
  @@index([orgId])
}

model EscalationPolicy {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  steps     EscalationStep[]
  incidents Incident[]

  @@unique([orgId, name])
  @@index([orgId])
}

model EscalationStep {
  id                 String               @id @default(cuid())
  orgId              String
  escalationPolicyId String
  stepOrder          Int
  waitMinutes        Int
  targetType         EscalationTargetType
  targetRotationId   String?
  targetUserId       String?

  policy   EscalationPolicy @relation(fields: [escalationPolicyId], references: [id], onDelete: Cascade)
  rotation Rotation?        @relation(fields: [targetRotationId], references: [id])

  @@unique([escalationPolicyId, stepOrder])
  @@index([orgId])
}

model Incident {
  id                    String           @id @default(cuid())
  orgId                 String
  serviceId             String
  title                 String
  status                IncidentStatus   @default(triggered)
  severity              IncidentSeverity @default(high)
  escalationPolicyId    String?
  currentEscalationStep Int              @default(0)
  createdAt             DateTime         @default(now())
  acknowledgedAt        DateTime?
  acknowledgedById      String?
  resolvedAt            DateTime?
  updatedAt             DateTime         @updatedAt

  org              Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  service          Service           @relation(fields: [serviceId], references: [id])
  escalationPolicy EscalationPolicy? @relation(fields: [escalationPolicyId], references: [id])
  acknowledgedBy   User?             @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])
  events           IncidentEvent[]

  @@index([orgId])
  @@index([orgId, status])
}

model IncidentEvent {
  id         String            @id @default(cuid())
  orgId      String
  incidentId String
  type       IncidentEventType
  actorId    String?
  payload    Json
  createdAt  DateTime          @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id])

  @@index([orgId])
  @@index([incidentId, createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  hashedKey  String
  prefix     String
  scopes     String[]
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@unique([prefix])
}
